{
  "compilerOptions": {
    "outDir": "./dist",            
    "module": "preserve",
    "moduleResolution": "Bundler",
    "target": "ES2023",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": true,
    "types": ["node"]
  },
  "include": ["**/*"],             
  "exclude": ["node_modules", "dist"]
}
